{
  "name": "bloom",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --no-warnings --test lib/cycle/*.test.ts lib/storage/*.test.ts lib/sync/*.test.ts lib/data/*.test.ts lib/report/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "lint": "expo lint",
    "build:icons": "node --experimental-strip-types --no-warnings scripts/build-icons.ts",
    "format": "prettier --write \"app/**/*.tsx\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"theme/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\"",
    "build:brand": "node --experimental-strip-types --no-warnings scripts/build-brand.ts",
    "build:design-system": "node --experimental-strip-types --no-warnings scripts/build-design-system.ts",
    "migrate:remote": "node scripts/migrate-remote.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
