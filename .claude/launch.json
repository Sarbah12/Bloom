{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bloom-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8096"
      ],
      "port": 8096
    },
    {
      "name": "bloom-metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "bloom-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8097",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site"
      ],
      "port": 8097
    }
  ]
}